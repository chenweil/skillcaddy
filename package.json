{
  "name": "skillcaddy",
  "version": "0.27.0",
  "description": "Local skill source library with project, global, and Hermes symlink scopes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skillcaddy": "scripts/tui.js"
  },
  "files": [
    "lib/",
    "scripts/cli.js",
    "scripts/source.js",
    "scripts/tui.js",
    "scripts/pull-github.sh",
    "scripts/cron-sync-update-git.sh",
    "public/",
    "skills/",
    "!skills/.claude",
    "collection-metadata/",
    "server.js",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenweil/skillcaddy.git"
  },
  "homepage": "https://github.com/chenweil/skillcaddy#readme",
  "bugs": {
    "url": "https://github.com/chenweil/skillcaddy/issues"
  },
  "keywords": [
    "skill",
    "skills",
    "agent",
    "claude-code",
    "codex",
    "opencode",
    "symlink",
    "skill-library"
  ],
  "scripts": {
    "start": "node server.js",
    "source": "node scripts/source.js",
    "test": "node --test test/*.test.js && npm run lint:imports && npm run check:specs",
    "test:unit": "node --test test/*.test.js",
    "check:specs": "node scripts/check-specs.js",
    "enable:spec-pipeline": "node scripts/enable-spec-pipeline.js",
    "lint:imports": "node scripts/check-imports.js",
    "lint": "node scripts/check-imports.js",
    "install:manager": "node scripts/manager-skill.js install",
    "check:manager": "node scripts/manager-skill.js check",
    "install:cli": "node scripts/tui-command.js install cli",
    "check:cli": "node scripts/tui-command.js check cli",
    "install:tui": "node scripts/tui-command.js install tui",
    "check:tui": "node scripts/tui-command.js check tui",
    "migrate:metadata": "node scripts/migrate-metadata.js",
    "pull:github": "bash scripts/pull-github.sh",
    "tui": "node scripts/tui.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tldts": "^7.4.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
