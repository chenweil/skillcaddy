+#[test]
+fn machine_argument_errors_are_json_while_help_remains_human() {
+    let fixture = Fixture::new();
+    for args in [
+        vec!["annotations", "--json", "--asset-id"],
+        vec!["export", "--json", "bad-index"],
+        vec!["doctor", "--json", "--unknown"],
+    ] {
+        let output = fixture.run(&args);
+        assert!(!output.status.success());
+        assert!(output.stdout.is_empty());
+        let value: Value = serde_json::from_slice(&output.stderr)
+            .expect("argument failures must remain machine-readable");
+        assert_eq!(value["schema_version"], 1);
+        assert_eq!(value["error"]["code"], "INVALID_ARGUMENT");
+    }
+    let help = fixture.run(&["doctor", "--json", "--help"]);
+    assert!(help.status.success());
+    assert!(help.stderr.is_empty());
+    assert!(String::from_utf8_lossy(&help.stdout).contains("Usage:"));
+    let human = fixture.run(&["export", "bad-index"]);
+    assert!(!human.status.success());
+    assert!(String::from_utf8_lossy(&human.stderr).contains("error:"));
+}
